# Copy this file to .env and change values as you like:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
# .env is ignored by git, so your local settings stay on your machine.
# Every value is optional; the defaults below are used when one is missing.

# ---------------- Window / game ----------------
WINDOW_WIDTH=1000
WINDOW_HEIGHT=600
FPS=60
SOUND_ENABLED=true
SOUND_VOLUME=0.5
SAVE_FILE=savegame.json

# ---------------- Hand gestures (webcam) ----------------
# 0 = built-in webcam; try 1, 2 ... for an external camera
CAMERA_INDEX=0
SHOW_CAMERA_PREVIEW=true
# 0.0-1.0: higher = fewer false detections but needs a clearer view of your hand
GESTURE_MIN_CONFIDENCE=0.6
# Majority vote over the last N camera frames (higher = steadier but slower to react)
GESTURE_SMOOTHING_FRAMES=5
# Downloaded automatically on first use
HAND_MODEL_PATH=models/hand_landmarker.task

# ---------------- Reinforcement learning (python train.py) ----------------
MODEL_PATH=models/q_table.json
TRAINING_LOG=models/training_log.csv
TRAIN_EPISODES=2000
LEARNING_RATE=0.1
DISCOUNT=0.98
EPSILON_START=1.0
EPSILON_END=0.02
EPSILON_DECAY_EPISODES=1500
TRAIN_SEED=42
MAX_EPISODE_SECONDS=90
